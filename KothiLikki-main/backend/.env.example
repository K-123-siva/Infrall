# Server Configuration
PORT=5000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-password
DB_NAME=nestbazaar

# JWT Secret (Generate random string)
JWT_SECRET=your-random-secret-key-here

# Cloudinary Configuration (Sign up at cloudinary.com)
CLOUDINARY_CLOUD_NAME=your-cloudinary-name
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret

# Frontend URL
CLIENT_URL=http://localhost:5173

# Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123456

# Email Configuration (Gmail)
# For Gmail: Enable 2FA and generate App Password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_FROM=INFRAALL <your-email@gmail.com>

# Razorpay Payment Gateway (Sign up at razorpay.com)
RAZORPAY_KEY_ID=your-razorpay-key
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Two Factor API (Sign up at 2factor.in)
TWOFACTOR_API_KEY=your-2factor-api-key

# Google OAuth (Get from console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Session Secret (Generate random string)
SESSION_SECRET=your-session-secret-key
